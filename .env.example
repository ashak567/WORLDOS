# WORLDOS Environment Configuration Template
# Copy this file to .env and configure local secrets.
# Never commit the .env file to Git.

# Operational PostgreSQL/PostGIS connection
WORLDOS_DATABASE_URL=postgresql://worldos:worldos_dev_only@localhost:5432/worldos

# OpenSky Network API Credentials (OAuth2 Client Credentials)
OPENSKY_CLIENT_ID=
# AISStream.io API Key (Free live maritime AIS WebSocket feed: https://aisstream.io)
AISSTREAM_API_KEY=

# NASA FIRMS Map Key (Free live VIIRS/MODIS thermal anomalies: https://firms.modaps.eosdis.nasa.gov/api/map_key)
NASA_FIRMS_MAP_KEY=

# The API key and agent ID belong in the root .env.local file, which Compose loads only into the API container.
WORLDOS_PUBLIC_READ_ONLY=false
WORLDOS_CORS_ORIGINS=*
WORLDOS_ENABLE_ASSISTANT=true
WORLDOS_RUN_MIGRATIONS_ON_START=false

# Cesium Ion Access Token (3D World Terrain & imagery: https://ion.cesium.com)
VITE_CESIUM_ION_TOKEN=

# Google Maps Platform (Map Tiles 3D, Places New, Aerial View, Routes, Geocoding)
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# YouTube Data API v3 (Travel vlogs, 4K room tours, walking tours)
YOUTUBE_API_KEY=
VITE_YOUTUBE_API_KEY=
